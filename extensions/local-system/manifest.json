{
  "manifest_version": 3,
  "name": "Local System",
  "version": "0.1.0",
  "icons": {
    "16": "icons/local-system-16.png",
    "32": "icons/local-system-32.png",
    "48": "icons/local-system-48.png",
    "128": "icons/local-system-128.png"
  },
  "description": "Adds Local System file references and previews, annotations, todos, and a code workspace to ChatGPT.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "tabs",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-file-workspace": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle the embedded Local System workspace"
    },
    "toggle-standalone-workspace": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open the Local System sidebar"
    }
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "thread-tail-clamp.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "thread-route.js",
        "shared-runtime.js",
        "thread-performance.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "css": [
        "ui-foundation.css",
        "composer-shared.css",
        "composer-context.css",
        "interaction-content.css",
        "thread-dashboard.css"
      ],
      "js": [
        "thread-route.js",
        "shared-runtime.js",
        "extension-api.js",
        "content.js",
        "standalone-workspace.js",
        "composer-context.js",
        "annotations-content.js",
        "interaction-content.js",
        "thread-dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.js",
        "viewer.css",
        "todos.html",
        "todos.js",
        "todos.css",
        "skills.html",
        "skills.js",
        "skills.css",
        "files.html",
        "files.js",
        "files.css",
        "file-quick-open.html",
        "file-quick-open.js",
        "file-quick-open.css",
        "file-workspace.html",
        "file-workspace.js",
        "file-workspace.css",
        "vendor/highlight.bundle.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Local System",
    "default_icon": {
      "16": "icons/local-system-16.png",
      "32": "icons/local-system-32.png"
    }
  }
}
