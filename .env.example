# chatgpt-local-system runtime configuration
# Copy to .env for interactive development, or to the per-user runtime.env used by service installers.

# Local HTTP MCP endpoint. Keep loopback unless you intentionally harden and expose it.
HOST=127.0.0.1
PORT=8765
# Chrome extension origins allowed to call /local-ui/* and /local-image/*.
# For unpacked extensions this ID is path-derived, so changing the extension
# directory can change the chrome-extension:// origin. Multiple origins may be
# comma-separated during migrations.
# LOCAL_EXTENSION_ORIGIN=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
# MCP_TOKEN=  # Optional for direct local clients. The documented tunnel profile does not inject this header.
BODY_LIMIT=2mb

# Project authority: parent directories the agent may access, separated by ':' on macOS/Linux or ';' on Windows.
# A root may contain many projects. workspace(open) selects one current project; workspace(save) stores an optional shortcut with metadata.
WORKSPACE_ROOTS=/absolute/path/to/projects
# Initial current project when no persisted selection exists. It must be inside WORKSPACE_ROOTS.
DEFAULT_WORKSPACE=/absolute/path/to/projects/example-project
# Optional personal skill catalog roots; defaults to ~/.agents/skills and ~/.local-system/.agents/skills.
# The bridge-owned ./skills directory is always included.
SKILL_ROOTS=~/.agents/skills:~/.local-system/.agents/skills
ALLOW_TOOL_ROOT_REGISTRATION=false
# Optional convenience roots (Desktop/Documents/Downloads/dev/etc.); false is safer.
INCLUDE_COMMON_WORKSPACE_ROOTS=false
# Additional protected paths, using the same platform path delimiter.
# BRIDGE_DENY_PATHS=/another/protected/path

# State, output, and concurrency bounds.
# BRIDGE_STATE_DIR=~/.chatgpt-local-system       # protected internal metadata; never a tool root
# Parent for automatically created, conversation-scoped workspaces for agent-owned non-project files and commands.
# BRIDGE_SCRATCH_DIR=~/.local-system/scratch
COMMAND_TIMEOUT_MS=120000
COMMAND_WAIT_MS=10000
MAX_STDOUT_CHARS=24000
MAX_STDERR_CHARS=12000
MAX_CONCURRENT_TOOLS=8
TURN_CHECKPOINT_MS=1200000
MAX_PROCESS_LOG_BYTES=10000000
PROCESS_RETENTION_DAYS=14
MAX_PROCESS_RECORDS=500

# Optional rich tool UIs in ChatGPT. A per-tool value overrides TOOL_UI.
TOOL_UI=false
TOOL_UI_APPLY_PATCH=true
TOOL_UI_EXECUTE_COMMAND=false
TOOL_UI_WRITE_TODOS=true
# TOOL_UI_DISPLAY=true
# TOOL_UI_DISCOVER_SKILLS=true

# Optional S3-backed media previews for display. When enabled, image/audio/video/PDF files are
# uploaded to a private bucket and rendered from a short-lived presigned URL. Any AWS/upload failure
# automatically falls back to the existing local MCP preview path.
FILE_PREVIEW_CLOUD_ENABLED=false
# FILE_PREVIEW_S3_BUCKET=chatgpt-sol-preview-123456789012-ap-south-1
# FILE_PREVIEW_AWS_PROFILE=personal
# FILE_PREVIEW_AWS_REGION=ap-south-1
# FILE_PREVIEW_AWS_BIN=aws
# FILE_PREVIEW_PRESIGN_SECONDS=3600
# FILE_PREVIEW_CLOUD_TIMEOUT_MS=300000
# FILE_PREVIEW_CLOUD_CATEGORIES=image,audio,video,pdf

# Tool child processes do not inherit secret-like env vars by default.
TOOL_ENV_INHERIT_SECRETS=false
# TOOL_ENV_ALLOWLIST=CODEX_ACCESS_TOKEN,MY_PROJECT_TOKEN
# TOOL_EXTRA_PATH=~/.local/bin:~/.npm-global/bin

# Cross-device request_user_input. Press Start in the private bot chat once; first use binds that chat locally.
# TELEGRAM_BOT_TOKEN=<botfather-token>
# Pin the pyobjc-capable interpreter for the macOS request_user_input dialog. Without it the helper uses
# whatever `python3` is first on PATH, so launching the bridge from a shell with a venv active
# silently disables the native prompt. ASK_USER_* names remain for backward-compatible runtime
# configuration. Set ASK_USER_DEBUG=1 to log question/answer routing.
# MACOS_ASK_USER_PYTHON=/usr/local/bin/python3
# ASK_USER_DEBUG=1
# ASK_USER_DEBUG_FILE=/tmp/ask-user-debug.log

# Destructive actions require an explicit Approve response through the same macOS/Telegram interaction surfaces used by request_user_input.
DESTRUCTIVE_AUDIT_FAIL_CLOSED=true
# Destructive actions require interactive human approval by default.
# Only explicitly set true if you accept bypassing approval prompts.
BYPASS_SECURITY=false

# Explicit hostnames only; wildcards are allowed as *.corp.example.

# Optional binaries/integrations.
CHATGPT_AGENT_BIN=cwa
SUBAGENT_BROWSER=
INTERCEPTOR_BIN=interceptor
# MACOS_SCREEN_DEVICE=1:none
# DISPLAY=:0.0
# SCREEN_SIZE=1920x1080

# Secure MCP Tunnel runtime values (keep runtime.env mode 0600 / user-only ACL).
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_ME
CONTROL_PLANE_API_KEY=sk-REPLACE_ME
TUNNEL_PROFILE=sol-local-bridge
TUNNEL_HEALTH_PORT=8766
TUNNEL_MCP_STARTUP_TIMEOUT_MS=120000
